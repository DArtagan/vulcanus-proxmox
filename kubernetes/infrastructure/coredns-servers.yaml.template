# The `servers` value for the CoreDNS HelmRelease, kept in plaintext as the
# reviewable original. The rendered copy lives in coredns-servers.sops.yaml and
# is what Flux applies, because DOH-SUBDOMAIN identifies a Cloudflare Gateway
# location and anyone holding it can resolve through this account's policies.
#
# Do not edit the encrypted copy by hand. Edit this file and re-render:
#
#     tools/coredns/render-servers-secret.sh <doh-subdomain>
#
# Two copies of a 70-line Corefile drifting apart is the obvious failure of this
# arrangement, so rendering is a script rather than a procedure. The encrypted
# file is a build artefact; this one is the source.
servers:
  - zones:
      - zone: .
        # Without this the chart renders a UDP port only. The live Service has
        # carried both udp-53 and tcp-53 since chart 1.29.0, and resolvers fall
        # back to TCP for responses that do not fit in a UDP datagram.
        use_tcp: true
    port: 53
    plugins:
      - name: errors
      - name: health
        configBlock: |-
          lameduck 5s
      - name: ready
      - name: prometheus
        parameters: 0.0.0.0:9153
      - name: any
      - name: bufsize
        parameters: 1232
      - name: cache
        parameters: 30
      - name: loop
      - name: reload
      - name: loadbalance
      # Forwards through Cloudflare Gateway so every device answered by this
      # server gets DNS-level ad, tracker and malware blocking. The unique
      # subdomain identifies the Gateway location, so there is no source-IP
      # dependency and a dynamic WAN IP does not matter.
      #
      # AdGuard's public resolver is a second upstream, not a decoration. This
      # server answers a household several states away; without a fallback, an
      # unreachable Gateway means nobody there has DNS and nobody involved can
      # walk in to fix it. AdGuard filters too, so failing over degrades to a
      # generic blocklist rather than to nothing.
      #
      # `policy sequential` is load-bearing. The default is random, which would
      # send roughly half of all queries to AdGuard — where the household's
      # allowlist does not exist — so exceptions would appear to work only half
      # the time. Sequential makes AdGuard a failover instead of a coin flip.
      #
      # The per-destination `%servername` form is what allows two DoT upstreams
      # with different names in one block. A block-level tls_servername applies
      # to every upstream at once and must not be set alongside it.
      #
      # The Gateway upstream is a hostname, and CoreDNS resolves upstream
      # hostnames once at startup: a restart while DNS is already broken cannot
      # resolve it and the server will not come up. The router's secondary DNS
      # entry is the backstop for that, which is why it points at AdGuard rather
      # than at an unfiltered resolver.
      - name: forward
        parameters: . tls://DOH-SUBDOMAIN.cloudflare-gateway.com%DOH-SUBDOMAIN.cloudflare-gateway.com tls://94.140.14.14%dns.adguard-dns.com
        configBlock: |-
          policy sequential
          health_check 5s
        # Hairpinning is not a concern: tailnet devices resolve immortalkeep.com
        # via Headscale split DNS → CoreDNS, infrastructure VMs use CoreDNS
        # directly, and LAN devices use CoreDNS via router DHCP (primary) with
        # Cloudflare (secondary) as fallback.
  - zones:
      - zone: immortalkeep.com
        use_tcp: true
    port: 53
    plugins:
      - name: errors
      - name: log
      - name: health
        configBlock: |-
          lameduck 5s
      - name: file
        parameters: /etc/coredns/db.immortalkeep.com
      - name: ready
      - name: prometheus
        parameters: 0.0.0.0:9153
      - name: reload
  # status.immortalkeep.com is a Cloudflare DNS entry that redirects to
  # the Uptime Robot status page — it is not served by the internal
  # ingress. This zone is more specific than immortalkeep.com above, so
  # CoreDNS answers it via public DNS instead of falling through to the
  # wildcard record, which would otherwise point it at the internal
  # ingress (no rule there for this host). Covers LAN clients (CoreDNS
  # via router DHCP) and tailnet clients (CoreDNS via Headscale split
  # DNS) with one change.
  - zones:
      - zone: status.immortalkeep.com
        use_tcp: true
    port: 53
    plugins:
      - name: errors
      - name: health
        configBlock: |-
          lameduck 5s
      - name: ready
      - name: forward
        parameters: . tls://1.1.1.1
        configBlock: |-
          tls_servername cloudflare-dns.com
          health_check 5s
